# DB de producción VIEJA (Supabase Postgres) — solo lectura, se usa una vez.
# Sacala de Render (env vars del backend actual), no necesariamente del .env local del repo viejo.
SOURCE_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres

# DB NUEVA (Neon) — mismo valor que packages/db/.env
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Clerk — Secret key (Backend API, para crear usuarios preservando el hash bcrypt)
CLERK_SECRET_KEY=sk_test_xxxxx

# Cloudinary — para volcar las imágenes de Supabase Storage
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx
